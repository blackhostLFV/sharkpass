# Copy to .env locally; never commit actual values. Node 22: node --env-file=.env --experimental-sqlite src/server.mjs
PUBLIC_URL=http://localhost:3201
HOST=127.0.0.1
PORT=3201
DATABASE_PATH=data/sharkpass.sqlite
# Leave all keys empty until the owner's Wompi Sandbox credentials are configured.
WOMPI_ENVIRONMENT=test
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Requires official HTTPS domain plus a completed provider test; keep disabled locally.
WOMPI_ENABLE_PRODUCTION=no
# Optional email adapter. Requires a verified sender/domain; no emails are sent without this configuration.
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Only used when MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_REPLY_TO=
MAIL_FROM=
# Only explicit IPs of reverse proxies you control; leave blank for direct connections.
# Proxy must append/overwrite X-Forwarded-For correctly. Never use '*' or trust arbitrary clients.
TRUSTED_PROXY_IPS=
